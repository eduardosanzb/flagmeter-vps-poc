# Database
DATABASE_URL=postgresql://flagmeter:flagmeter@localhost:5432/flagmeter

# Redis/Valkey
VALKEY_URL=redis://localhost:6379

# Worker
WORKER_CONCURRENCY=4
QUEUE_NAME=events

# Environment
NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=3000

# Observability
LOKI_URL=http://localhost:3100

# Security (optional - defaults to restrictive settings)
# CORS: Comma-separated list of allowed origins (default: none, same-origin only)
# Example: CORS_ORIGIN=https://app.example.com,https://www.example.com
CORS_ORIGIN=

# Request size limit in KB (default: 100KB)
MAX_REQUEST_SIZE_KB=100
